# ------------------------------------------------------------------
# VulnTrack - Plantilla de variables de entorno
# Copie este archivo a .env y rellene con valores reales:
#   cp .env.example .env
# NUNCA versione el archivo .env con valores reales.
# ------------------------------------------------------------------

# Configuración de Base de Datos (superusuario que crea la BD)
DB_NAME=vulntrack
DB_USER=admin_db
DB_PASSWORD=cambia_esta_password

# Cuenta de bajo privilegio que usa la API (debe existir en init.sql)
DB_APP_USER=app_user
DB_APP_PASSWORD=cambia_esta_password_de_app

# Configuración de Redis
# Host del servicio Redis (nombre del contenedor en docker-compose)
REDIS_HOST=securehub-redis
REDIS_PASSWORD=cambia_esta_password_redis

# Orígenes permitidos por CORS, separados por comas (CSV).
# Incluya localhost y, si accede al dev server de Vite por la IP de la LAN,
# añada ese origen con su puerto, p. ej. http://192.168.80.79:5173
# En desarrollo (NODE_ENV != 'production') el backend además acepta
# automáticamente cualquier localhost/127.0.0.1 o IP privada (10.x, 172.16-31.x,
# 192.168.x) en cualquier puerto; esta lista es la autoridad en PRODUCCIÓN.
CORS_ORIGINS=http://localhost:5173,http://localhost,http://192.168.80.79:5173

# Firma criptográfica de los JWT. Use una cadena larga y aleatoria, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=genere_un_secreto_aleatorio_largo

# (Opcional) API Key de NIST/NVD para evitar rate-limit en la ingesta de CVEs
NVD_API_KEY=

# ------------------------------------------------------------------
# Correo SMTP para las notificaciones del worker (alertas de SLA)
# El worker (securehub-worker) usa estas variables con nodemailer.
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ------------------------------------------------------------------
# Infra DevSecOps
# ------------------------------------------------------------------
# Intervalo del scanner Trivy en milisegundos (por defecto 6 horas).
SCANNER_INTERVAL_MS=21600000

# DISABLE_BACKGROUND_WORKERS la fija docker-compose en la API (="true"): los workers
# SLA/NVD corren en el contenedor securehub-worker, no dentro de la API. No es un
# secreto; se documenta aqui para contextos fuera de docker-compose (si se levanta la
# API suelta y se quiere que ella misma corra los workers, dejela sin definir o "false").

# Token del bot de Telegram para Alertmanager: NO va en este .env. Se provee como
# archivo fuera del repo en monitoring/alertmanager/telegram-token.txt (ver el
# .example de ese directorio). El archivo real esta en .gitignore.
